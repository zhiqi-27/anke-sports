{
  "name": "anke-sports-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "account_id": "6be1e7b072eb22de20bb3c58fbf56585",
  "routes": [{ "pattern": "sports.anke-ai.com", "custom_domain": true }],
  "vars": {
    "AZURE_API_ORIGIN": "https://anke-sports-dev-mtcflttk.azurewebsites.net",
  },
  "assets": {
    "directory": ".next-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
}
